#include <windows.h>

// 应用程序图标
IDI_MEMOPT ICON "memopt.ico"

// 版本信息
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "MemOpt"
            VALUE "FileDescription", "MemOpt - Memory Optimization Tool"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "memopt"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "memopt.exe"
            VALUE "ProductName", "MemOpt"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
